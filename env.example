# Database - PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/harmonia?schema=public"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=harmonia

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Server
PORT=3000
NODE_ENV=development
APP_NAME=Harmonia
APP_URL=http://localhost:3000

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Harmonia Music" <noreply@harmonia.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# API Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# WebSocket Configuration
WEBSOCKET_CORS_ORIGIN=http://localhost:3000

# File Storage (optional - for cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=harmonia-music-files

# Analytics and Monitoring
ANALYTICS_ENABLED=true
LOG_LEVEL=info

# Chatbot Configuration
CHATBOT_ENABLED=true
CHATBOT_RESPONSE_DELAY=1000

# Notification Settings
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true 